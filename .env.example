# Optional. A GitHub token (no scopes needed for public repos) raises the API
# rate limit from 60 to 5,000 requests/hour. Used on the server only.
GITHUB_TOKEN=

# Optional. VirusTotal API key for known-malware hash lookups on the server.
# Without it, the web malware panel reports the check as unavailable. The free
# public API allows about 4 lookups/minute and 500/day, and is subject to
# VirusTotal's terms — review them before shared or commercial use.
VIRUSTOTAL_API_KEY=

# Optional. Public site URL, used for Open Graph image links.
NEXT_PUBLIC_SITE_URL=

# Optional. Per-IP requests per minute to /api/resolve (default 30).
RESOLVE_RATE_LIMIT_PER_MIN=

# Testing only — points the server at a mock GitHub API. Leave unset in production.
GITHUB_API_BASE_URL=

# Optional. Enables the /review page (Gemma 4 code review via the Gemini API).
# Get keys at https://aistudio.google.com/apikey. Used on the server only.
# One key works; several (comma- or newline-separated) rotate when one is rate limited.
GEMINI_API_KEYS=
# A single key also works here; it's merged with GEMINI_API_KEYS.
GEMINI_API_KEY=

# Optional. Primary model (default gemma-4-31b-it), fallbacks when it's rate limited or
# overloaded (default gemma-4-26b-a4b-it; "none" disables), and per-IP reviews per minute (default 3).
REVIEW_MODEL=
REVIEW_FALLBACK_MODELS=
REVIEW_RATE_LIMIT_PER_MIN=

# Optional. "minimal" (default: fits the 300s function limit) or "high" (slower, more thorough).
REVIEW_THINKING=

# Optional. Per-request input token cap to trim large diffs up front (e.g. 16000 on the free tier).
REVIEW_MAX_INPUT_TOKENS=

# Testing only — points reviews at a mock Gemini API. Leave unset in production.
GEMINI_API_BASE_URL=

# Testing only — points the server at a mock VirusTotal API. Leave unset in production.
VIRUSTOTAL_API_BASE_URL=
