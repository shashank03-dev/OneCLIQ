{
  "name": "onecliq",
  "version": "0.1.1",
  "description": "Find and download the right file from any GitHub release for this machine, and review pull requests with Gemma 4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashank03-dev/OneCLIQ.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/shashank03-dev/OneCLIQ",
  "bugs": {
    "url": "https://github.com/shashank03-dev/OneCLIQ/issues"
  },
  "type": "module",
  "bin": {
    "oqgit": "dist/oqgit.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github",
    "releases",
    "download",
    "cli",
    "code-review",
    "pull-request",
    "gemma",
    "mcp"
  ],
  "scripts": {
    "prepublishOnly": "test -f dist/oqgit.mjs || (echo 'Run npm run cli:build from the repo root first' && exit 1)"
  },
  "publishConfig": {
    "access": "public"
  }
}
